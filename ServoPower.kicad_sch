	)
	(text "Kelvin: NT401/NT402 (LTC7803 SENSE at RS401), NT404/NT405 (INA240 at RS402), NT403 (feedback tap). Route each pair as separate close traces from the shunt pads. Compensation and RF/CF are start values."
		(exclude_from_sim no)
		(at 25.4 35.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f21bb261-c44e-556e-a592-9b6b51f9a672")
	)
	(text "SERVO_PWR_DIS, VSERVO_SENSE, ISERVO_SENSE, +V_SERVO and +3V3 are global until the Controller and Actuators sheets exist. SERVO_PWR_DIS high pulls RUN low: regulator shutdown, not a power disconnect."
		(exclude_from_sim no)
		(at 25.4 40.64 0)
