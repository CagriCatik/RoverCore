(version 1)
(rule "JLC track width" (condition "A.Type == 'Track'") (constraint track_width (min 0.09mm)))
(rule "JLC via drill" (condition "A.Type == 'Via'") (constraint hole_size (min 0.15mm)))
(rule "JLC via ring" (condition "A.Type == 'Via'") (constraint annular_width (min 0.05mm)))
(rule "JLC PTH ring" (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'") (constraint annular_width (min 0.15mm)))
(rule "JLC NPTH size" (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'") (constraint hole_size (min 0.5mm)))
(rule "JLC PTH hole to copper" (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'") (constraint hole_clearance (min 0.28mm)))
(rule "JLC PTH hole to inner copper" (layer inner) (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'") (constraint hole_clearance (min 0.3mm)))
(rule "JLC via hole to copper" (condition "A.Type == 'Via'") (constraint hole_clearance (min 0.2mm)))
(rule "JLC NPTH to copper" (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'") (constraint hole_clearance (min 0.2mm)))
(rule "JLC pad hole to hole" (condition "A.Type == 'Pad' && B.Type == 'Pad'") (constraint hole_to_hole (min 0.45mm)))
(rule "JLC pad to pad" (condition "A.Type == 'Pad' && B.Type == 'Pad'") (constraint clearance (min 0.15mm)))
(rule "JLC edge" (constraint edge_clearance (min 0.2mm)))
(rule "JLC silk text" (layer "?.Silkscreen") (constraint text_height (min 1.0mm)) (constraint text_thickness (min 0.15mm)))
(rule "JLC silk to mask" (layer "?.Silkscreen") (constraint silk_clearance (min 0.15mm)))
